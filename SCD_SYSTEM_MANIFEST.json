{
  "$schema": "./SCD_SYSTEM_MANIFEST.schema.json",
  "manifest": {
    "id": "scd-colicoderviese-system",
    "name": "SCD SYSTEM MANIFEST",
    "version": "1.7.0",
    "effective_at": "2026-09-29",
    "status": "BINDING",
    "language": "it-IT",
    "timezone": "Europe/Rome",
    "authority": "DIREZIONE_SCD",
    "canonical_repository": "francesco1485/scd-colicoderviese-super-app",
    "change_policy": {
      "manifest_first": true,
      "rule": "Ogni modifica che cambia architettura, dati, ruoli, fonti, routing, sicurezza, UX, telemetria o capacità deve aggiornare questo manifest nello stesso PR o prima del codice.",
      "breaking_change_requires_direction_approval": true,
      "no_silent_reinterpretation": true,
      "legacy_documents_are_non_normative": true,
      "state_first": true,
      "no_write_without_verified_state": true,
      "unverified_is_not_false_or_absent": true
    },
    "supersedes_as_normative_authority": [
      "PROJECT_CONSTITUTION.md",
      "SCD_PERMANENT_COMMANDS.md",
      "VISUAL_SYSTEM_LOCK.md"
    ],
    "supporting_specs": [
      "EVOLUTION_ENGINE.md",
      "MESSAGING_SECURITY_CONTRACT.md",
      "MEDIA_ASSET_POLICY.md",
      "PLAY_STORE_SUBMISSION.md"
    ]
  },
  "north_star": {
    "definition": "Un unico sistema operativo digitale della S.D.C. ColicoDerviese che rappresenta l'intera società sportiva, non un sito e non una sola agenda.",
    "single_product": true,
    "channels": [
      "WEB_DESKTOP",
      "WEB_MOBILE",
      "PWA",
      "ANDROID",
      "IOS_FUTURE"
    ],
    "single_codebase_preference": true,
    "same_data_same_permissions_same_identity_across_channels": true,
    "drive_and_gmail_are_backoffice_engines": true,
    "r20_must_not_be_replaced_without_verified_migration": true,
    "progressive_evolution_not_rewrite": true
  },
  "non_negotiable_invariants": [
    {
      "id": "INV-001",
      "statement": "La Super App è un'applicazione cross-platform, non una landing page o un sito aziendale generico.",
      "enforcement": "BLOCKING"
    },
    {
      "id": "INV-002",
      "statement": "Desktop e mobile sono viste responsive dello stesso prodotto e degli stessi dati; il desktop non è una semplice cornice smartphone da 430px.",
      "enforcement": "BLOCKING_TARGET"
    },
    {
      "id": "INV-003",
      "statement": "Drive e Gmail sportclubcolico@gmail.com sono il back-office informativo permanente; i file originali restano catalogabili e recuperabili.",
      "enforcement": "BLOCKING"
    },
    {
      "id": "INV-004",
      "statement": "R20 resta il motore operativo esistente per identità, ruoli, scope e funzioni gestionali finché una migrazione verificata non viene approvata.",
      "enforcement": "BLOCKING"
    },
    {
      "id": "INV-005",
      "statement": "Account unico: ogni persona nasce UTENTE_BASE e riceve successivamente ruoli/scope autorizzati dalla Direzione.",
      "enforcement": "BLOCKING"
    },
    {
      "id": "INV-006",
      "statement": "Nessun dato sportivo deve essere inventato; se assente usare DATO_IN_AGGIORNAMENTO o stato equivalente.",
      "enforcement": "BLOCKING"
    },
    {
      "id": "INV-007",
      "statement": "Safeguarding è separato da CRM, chat ordinaria, analytics, ticketing e community.",
      "enforcement": "BLOCKING"
    },
    {
      "id": "INV-008",
      "statement": "Le tavole grafiche approvate sono la Source of Truth visiva e devono essere tradotte in componenti reali, non usate come semplici immagini decorative.",
      "enforcement": "BLOCKING_TARGET"
    },
    {
      "id": "INV-009",
      "statement": "Ogni evento societario esiste una sola volta e viene proiettato sulle viste autorizzate di società, squadra, atleta, famiglia, staff, impianto e comunicazioni.",
      "enforcement": "BLOCKING_TARGET"
    },
    {
      "id": "INV-010",
      "statement": "Nessun cambiamento critico autonomo in produzione su ruoli, permessi, pagamenti, tesseramenti, presenze, documenti, dati personali o safeguarding.",
      "enforcement": "BLOCKING"
    },
    {
      "id": "INV-011",
      "statement": "Ogni nuova fonte esterna entra tramite Source Adapter con trust, dominio, timestamp, URL/identificatore e regole di conflitto.",
      "enforcement": "BLOCKING_TARGET"
    },
    {
      "id": "INV-012",
      "statement": "La piattaforma deve poter crescere per moduli, adapter, comandi, schema versionato e feature flag senza ricominciare da zero.",
      "enforcement": "BLOCKING_TARGET"
    }
  ],
  "product": {
