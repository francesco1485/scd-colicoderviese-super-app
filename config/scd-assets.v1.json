  "format_policy": {
    "version": "1.0.0",
    "effective_at": "2026-10-13",
    "origin": [
      "USER_COMMAND CMD-20260930-0832 ('SVG nativo', 'raster asset solo come placeholder')",
      "LAUNCH_BACKLOG L3 (2026-10-12): crest and sponsor logos SVG when an official vector exists, cut-outs PNG with alpha, photos WebP/JPG"
    ],
    "never": [
      "regenerate, redraw or alter an official asset to satisfy this policy",
      "trace or auto-vectorize a raster and present it as an official SVG",
      "lossy re-encode of a LOCKED mark; new derivatives of marks are lossless WebP or the official file itself"
    ],
    "rules": {
      "VECTOR_MARK": {
        "description": "Crests, federation/affiliation marks, sponsor and partner logos, category badges.",
        "formats": [
          "svg",
          "png",
          "webp"
        ],
        "preferred": "svg",
        "raster_requires_vector_status": [
          "RESEARCH_REAL_ASSET",
          "NO_OFFICIAL_VECTOR_KNOWN"
        ],
        "png_requires_alpha": true,
        "new_webp_derivative_encoding": "lossless"
      },
      "CUTOUT": {
        "description": "Mascots and characters cut out from their background.",
        "formats": [
          "png",
          "webp"
        ],
        "alpha_required": true
      },
      "PHOTO": {
        "description": "Photos, posters, kit boards, illustrations and plans with an opaque background.",
        "formats": [
          "webp",
          "jpg",
          "jpeg"
        ]
      },
      "DOCUMENT": {
        "description": "Official club documents.",
        "formats": [
          "pdf"
        ]
      },
      "APP_ICON": {
        "description": "PWA/OS icons; the web app manifest and iOS require PNG.",
        "formats": [
          "png"
        ]
      },
      "SOURCE_ORIGINAL": {
        "description": "Original file kept unchanged next to its runtime rendition; never referenced by runtime code.",
        "formats": [
          "png",
          "webp",
          "jpg",
          "jpeg",
          "svg"
        ],
        "must_not_be_referenced_by_runtime_code": true,
        "requires_rendition": true
      }
    },
    "class_rules": {
      "OFFICIAL_CLUB_LOGO": "VECTOR_MARK",
      "OFFICIAL_CLUB_LOGO_OPTIMIZED": "VECTOR_MARK",
      "FEDERATION_LOGO": "VECTOR_MARK",
      "FEDERATION_LOGO_OPTIMIZED": "VECTOR_MARK",
      "AFFILIATION_PARTNER_LOGO": "VECTOR_MARK",
      "AFFILIATION_PARTNER_LOGO_OPTIMIZED": "VECTOR_MARK",
      "OFFICIAL_AFFILIATION_LOGO": "VECTOR_MARK",
      "SPONSOR_LOGO": "VECTOR_MARK",
      "SPONSOR_LOGO_BOARD_CROP": "VECTOR_MARK",
      "CATEGORY_BADGE_RENDITION": "VECTOR_MARK",
      "CATEGORY_BADGE_SOURCE": "SOURCE_ORIGINAL",
      "OFFICIAL_CLUB_MASCOT": "CUTOUT",
      "OFFICIAL_CLUB_MASCOT_OPTIMIZED": "CUTOUT",
      "MASCOT_CUTOUT": "CUTOUT",
      "CHARACTER_CUTOUT": "CUTOUT",
      "MASCOT_ILLUSTRATION": "PHOTO",
      "CHARACTER_AVATAR_TILE": "PHOTO",
      "SUPPLIER_KIT_BOARD": "PHOTO",
      "EVENT_POSTER": "PHOTO",
      "VENUE_PHOTO": "PHOTO",
      "FACILITY_PLAN": "PHOTO",
      "OFFICIAL_CLUB_DOCUMENT": "DOCUMENT",
      "APP_ICON": "APP_ICON"
    },
