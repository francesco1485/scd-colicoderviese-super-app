    {
      "id": "T01_PUBLIC_EDITORIAL",
      "purpose": "Public club presentation, news, verified statistics, teams, structures and projects",
      "allowedPrimitives": [
        "LOGO_LOCKUP",
        "TEAM_BADGE",
        "PLAYER_TOKEN",
        "STATUS_CHIP",
        "SOURCE_BADGE",
        "MEDIA_TILE",
        "ACTION_BUTTON",
        "PROVENANCE_TAG"
      ],
      "density": "BALANCED",
      "responsiveMode": "EDITORIAL_REFLOW"
    },
    {
