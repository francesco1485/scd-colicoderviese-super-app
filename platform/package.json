{
  "name": "@scd/command-platform",
  "version": "22.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/commandWorker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/api/server.js",
    "worker": "node dist/src/worker/commandWorker.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "bullmq": "^5.58.5",
    "chokidar": "^4.0.3",
    "fastify": "^5.6.1",
    "ioredis": "^5.7.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
